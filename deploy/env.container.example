# Copy to /opt/saigon-staff/saigon-corner/.env.container
# Docker Compose loads this into containers WITHOUT interpolating $ in values.
# Do not put DATABASE_URL here.
# Quote POSTGRES_PASSWORD if it contains spaces; $ % £ are OK as-is.

NODE_ENV=production
PORT=3100
POSTGRES_PASSWORD=change-me-to-a-simple-hex-password
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://saigon-corner.pollen-8.co.uk
WEB_URL=https://saigon-corner.pollen-8.co.uk
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=