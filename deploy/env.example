# Copy to the server as /opt/saigon-staff/saigon-corner/.env — every line below must be active (no leading #).

NODE_ENV=production
PORT=3100

POSTGRES_PASSWORD=
# Do not set DATABASE_URL here — the container entrypoint builds it (URL-encodes the password).
# Special characters in POSTGRES_PASSWORD (! % $ £ etc.) are fine.

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://saigon-corner.pollen-8.co.uk
WEB_URL=https://saigon-corner.pollen-8.co.uk

ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=