# Default uses host Postgres on 5432. For Docker Compose only, use port 5433:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/saigon_staff
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saigon_staff
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
PORT=3100
WEB_PORT=5280
BETTER_AUTH_URL=http://localhost:3100
WEB_URL=http://localhost:5280
VITE_AUTH_URL=http://localhost:3100

# Comma-separated emails allowed to sign in (Google OAuth)
ADMIN_EMAILS=you@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=