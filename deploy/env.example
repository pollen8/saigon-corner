
# --- Production (DigitalOcean droplet) ---
# Copy this block to .env on the server at /opt/saigon-staff/.env
#
# NODE_ENV=production
# PORT=3100
# POSTGRES_PASSWORD=thisistheendoftheroad
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/saigon_staff
# BETTER_AUTH_SECRET=openssl-rand-base64-32
# BETTER_AUTH_URL=https://saigon-corner.pollen-8.co.uk
# WEB_URL=https://saigon-corner.pollen-8.co.uk
# ADMIN_EMAILS=you@gmail.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Google OAuth redirect (production):
# https://saigon-corner.pollen-8.co.uk/api/auth/callback/google
#
# Docker image build (Haven-style): pass BETTER_AUTH_URL as VITE_AUTH_URL build arg.