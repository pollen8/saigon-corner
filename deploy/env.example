# Copy to the server as /opt/saigon-staff/saigon-corner/.env — every line below must be active (no leading #).

NODE_ENV=production
PORT=3100

# Quote if the password contains $, %, spaces, or £ — otherwise Compose may mangle it:
# POSTGRES_PASSWORD='your-password-here'
POSTGRES_PASSWORD=
# Do not set DATABASE_URL in this file.

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://saigon-corner.pollen-8.co.uk
WEB_URL=https://saigon-corner.pollen-8.co.uk

ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=